generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LinkStatus {
  ACTIVE
  HIDDEN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links Link[]
  domains Domain[]
  QrCode QrCode[]

  @@map("users")
}

model Link {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  domainId String
  domains Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  title String?
  originalUrl String
  slug String
  status LinkStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  LinkVisit LinkVisit[]
  QrCode QrCode[]
  
  @@unique([domainId, slug])
  @@map("links")
}

model LinkVisit {
  id String @id @default(cuid())

  linkId String
  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  referrer String?
  visitedAt DateTime @default(now())

  // index untuk query performance
  @@index([linkId])

  // composite index untuk query performance
  @@index([linkId, visitedAt])

  @@map("link_visits")
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DnsRecordType {
  CNAME
  A
}

model Domain {
  id String @id @default(cuid())
  
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  domainName String @unique
  dnsTarget String?
  dnsRecordType DnsRecordType @default(CNAME)
  status DomainStatus @default(PENDING)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links Link[]

  @@map("domains")
}

model QrCode {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  linkId String
  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  title String?
  destinationUrl String
  styles Json? 
  logoUrl String? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qr_codes")
}
